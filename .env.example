# Copy to .env and fill values
SECRET_KEY=replace-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aos_nwc_ads
DB_USER=nwcads
DB_PASSWORD=change-me

# Authentication: "entra" (production) or "dev" (no sign-in; local machine or IP-restricted only)
AUTH_MODE=entra
# DEV_ROLE=Admin          # Viewer, Editor, or Admin; used only when AUTH_MODE=dev

# Microsoft Entra ID app registration (from IT)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=https://nwcads.archseattle.org/auth/callback
